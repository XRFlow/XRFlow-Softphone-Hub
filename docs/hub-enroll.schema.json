{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xrflows.com/docs/hub-enroll.schema.json",
  "title": "XRFlow Softphone Hub enroll payload",
  "description": "Returned by POST /xrflow-hub/v1/enroll/redeem. Never includes presence-sync write keys.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "host": { "type": "string" },
    "https": { "type": "boolean" },
    "sipDomain": { "type": "string" },
    "uriUser": { "type": "string" },
    "authUser": { "type": "string" },
    "sipSecret": { "type": "string" },
    "displayName": { "type": "string" },
    "sipWebsocketUrl": { "type": "string" },
    "sipLanWebsocketUrl": { "type": "string" },
    "sipPreferVpnLan": { "type": "boolean" },
    "amiHost": { "type": "string" },
    "amiPort": { "type": "integer" },
    "amiUsername": { "type": "string" },
    "amiSecret": { "type": "string" },
    "oauthClientId": { "type": "string" },
    "oauthClientSecret": { "type": "string" },
    "ucpUrl": { "type": "string", "description": "User Control Panel base URL." },
    "ucpUsername": { "type": "string", "description": "Desk User Manager username. The installed softphone signs in as the 97 device id with the SIP secret." },
    "ucpPassword": { "type": "string", "description": "Password for ucpUsername. The installed softphone uses the companion device SIP secret." },
    "ucpError": { "type": "string", "description": "Empty when UCP login was set up. Otherwise why voicemail login could not be issued." },
    "ucp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "openVpnHint": { "type": "string" },
    "openVpnProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "config", "files"],
      "properties": {
        "filename": { "type": "string" },
        "config": { "type": "string", "description": "Unmodified System Admin client config. Remotes are not rewritten." },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "content"],
            "properties": {
              "name": { "type": "string" },
              "content": { "type": "string" }
            }
          }
        }
      }
    },
    "seatKey": { "type": "string" },
    "companyPresence": { "type": "boolean" },
    "policy": {
      "type": "object",
      "properties": {
        "minVersion": { "type": "string" },
        "lockSettings": { "type": "boolean" }
      }
    }
  }
}
