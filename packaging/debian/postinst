#!/bin/bash
set -euo pipefail

MODULE_SRC="/usr/share/xrflow-softphone-hub/module"
MODULE_DEST="/var/www/html/admin/modules/xrflowsoftphone"
FPBX_MODULES="/var/www/html/admin/modules"

install_module_tree() {
  mkdir -p "$MODULE_DEST"
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --delete \
      --exclude '.git' \
      --exclude 'packaging' \
      --exclude 'dist' \
      "$MODULE_SRC/" "$MODULE_DEST/"
  else
    find "$MODULE_DEST" -mindepth 1 -maxdepth 1 ! -name '.git' -exec rm -rf {} +
    cp -a "$MODULE_SRC/." "$MODULE_DEST/"
  fi
  if id asterisk >/dev/null 2>&1; then
    chown -R asterisk:asterisk "$MODULE_DEST"
  fi
}

enable_apache() {
  if [ -d /etc/apache2/conf-available ] && command -v a2enconf >/dev/null 2>&1; then
    a2enconf xrflow-softphone-hub >/dev/null 2>&1 || true
    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet apache2 2>/dev/null; then
      systemctl reload apache2 || true
    elif command -v apache2ctl >/dev/null 2>&1; then
      apache2ctl graceful || true
    fi
    return
  fi
  if [ -d /etc/httpd/conf.d ]; then
    if [ ! -e /etc/httpd/conf.d/xrflow-softphone-hub.conf ] && [ -f /etc/apache2/conf-available/xrflow-softphone-hub.conf ]; then
      ln -sf /etc/apache2/conf-available/xrflow-softphone-hub.conf /etc/httpd/conf.d/xrflow-softphone-hub.conf
    fi
    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet httpd 2>/dev/null; then
      systemctl reload httpd || true
    fi
  fi
}

register_freepbx() {
  fwconsole ma install xrflowsoftphone
  fwconsole chown
  fwconsole reload || true
}

case "${1:-}" in
  configure)
    if [ -x /usr/share/xrflow-softphone-hub/check-freepbx.sh ]; then
      /usr/share/xrflow-softphone-hub/check-freepbx.sh
    fi
    if [ ! -d "$FPBX_MODULES" ]; then
      echo "xrflow-softphone-hub: FreePBX modules dir $FPBX_MODULES is missing." >&2
      exit 1
    fi
    install_module_tree
    register_freepbx
    enable_apache
    ;;
esac

exit 0
